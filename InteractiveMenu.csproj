<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Windows-TFM нужен для WinRT API (что сейчас играет — для живых состояний шариков) -->
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>InteractiveMenu</AssemblyName>
    <RootNamespace>InteractiveMenu</RootNamespace>
    <!-- запустится и на .NET 9/10, если 8-го рантайма нет -->
    <RollForward>Major</RollForward>
    <ApplicationIcon>Assets\icon.ico</ApplicationIcon>

    <!-- Локальная сборка = dev (без автообновлений). GitHub Actions подставляет настоящую версию. -->
    <Version>0.0.0-dev</Version>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Product>InteractiveMenu</Product>
    <Authors>Reuz0201</Authors>
  </PropertyGroup>

  <ItemGroup>
    <!-- яркость встроенного экрана ноутбука (WMI) -->
    <PackageReference Include="System.Management" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\icon.ico" />
    <Resource Include="Assets\icon.png" />
  </ItemGroup>

</Project>
