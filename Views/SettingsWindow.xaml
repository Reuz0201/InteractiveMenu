<Window x:Class="InteractiveMenu.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:m="clr-namespace:InteractiveMenu.Models"
        xmlns:v="clr-namespace:InteractiveMenu.Views"
        Title="InteractiveMenu"
        Width="1120" Height="740" MinWidth="900" MinHeight="580"
        WindowStartupLocation="CenterScreen"
        Background="#0F0F14"
        Foreground="#ECECF1"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="B2V" />
            <v:ActionTypeNameConverter x:Key="TypeName" />
            <v:PlusOneConverter x:Key="PlusOne" />
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ===================== боковое меню ===================== -->
        <Border Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
            <DockPanel Margin="14,20,14,16">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="6,0,0,26">
                    <Image Source="pack://application:,,,/Assets/icon.png" Width="34" Height="34" />
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="InteractiveMenu" FontSize="15" FontWeight="SemiBold" />
                        <TextBlock x:Name="VersionText" Text="v1.0.0" FontSize="11.5" Foreground="{StaticResource TextFaintBrush}" />
                    </StackPanel>
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom">
                    <Button Style="{StaticResource AccentButton}" Click="Preview_Click" Padding="12,10"
                            ToolTip="Открыть меню прямо сейчас — с текущими (даже несохранёнными) изменениями">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="▶" Margin="0,0,8,0" />
                            <TextBlock Text="Проверить меню" />
                        </StackPanel>
                    </Button>
                    <TextBlock x:Name="SidebarHotkeyHint" Margin="4,10,4,0" FontSize="11.5" TextWrapping="Wrap"
                               Foreground="{StaticResource TextFaintBrush}" TextAlignment="Center"
                               Text="или зажми Alt + Q где угодно" />
                </StackPanel>

                <StackPanel>
                    <RadioButton x:Name="NavMenu" Style="{StaticResource NavItem}" GroupName="Nav" IsChecked="True" Checked="Nav_Checked">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🌳" FontFamily="Segoe UI Emoji" Width="28" />
                            <TextBlock Text="Структура меню" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavControls" Style="{StaticResource NavItem}" GroupName="Nav" Checked="Nav_Checked">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⌨" FontFamily="Segoe UI Emoji" Width="28" />
                            <TextBlock Text="Хоткей и запуск" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavLook" Style="{StaticResource NavItem}" GroupName="Nav" Checked="Nav_Checked">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🎨" FontFamily="Segoe UI Emoji" Width="28" />
                            <TextBlock Text="Внешний вид" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavUpdates" Style="{StaticResource NavItem}" GroupName="Nav" Checked="Nav_Checked">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🔄" FontFamily="Segoe UI Emoji" Width="28" />
                            <TextBlock Text="Обновления" />
                        </StackPanel>
                    </RadioButton>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ===================== содержимое ===================== -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ============ страница: структура меню ============ -->
            <Grid x:Name="PageMenu" Margin="26,22,26,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Margin="0,0,0,16">
                    <TextBlock Style="{StaticResource H1}" Text="Структура меню" />
                    <TextBlock Style="{StaticResource Sub}" Margin="0,4,0,0"
                               Text="Слева — дерево шариков, справа — настройки выбранного. Категории раскрываются в меню при наведении, кнопки что-то делают." />
                </StackPanel>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="320" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- дерево -->
                    <Border Style="{StaticResource Card}" Padding="10">
                        <DockPanel>
                            <Grid DockPanel.Dock="Top" Margin="4,2,2,10">
                                <StackPanel Orientation="Horizontal">
                                    <Button Click="AddCategory_Click" Padding="10,6" Margin="0,0,6,0"
                                            ToolTip="Добавить категорию — из неё будут расти ветки">
                                        <TextBlock Text="＋ Категория" />
                                    </Button>
                                    <Button Click="AddButton_Click" Padding="10,6"
                                            ToolTip="Добавить кнопку — она выполняет действия">
                                        <TextBlock Text="＋ Кнопка" />
                                    </Button>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Style="{StaticResource IconButton}" Content="↑" ToolTip="Поднять выше" Click="MoveUp_Click" />
                                    <Button Style="{StaticResource IconButton}" Content="↓" ToolTip="Опустить ниже" Click="MoveDown_Click" />
                                    <Button Style="{StaticResource DangerIconButton}" Content="✕" ToolTip="Удалить" Click="Delete_Click" />
                                </StackPanel>
                            </Grid>

                            <TreeView x:Name="Tree" SelectedItemChanged="Tree_SelectedItemChanged">
                                <TreeView.ItemTemplate>
                                    <HierarchicalDataTemplate DataType="{x:Type m:MenuNode}" ItemsSource="{Binding Children}">
                                        <StackPanel Orientation="Horizontal">
                                            <Grid Width="30" Height="30">
                                                <Ellipse Fill="{Binding BallBrush}" />
                                                <TextBlock Text="{Binding Icon}" FontFamily="Segoe UI Emoji" FontSize="14"
                                                           Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Grid>
                                            <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Title}" FontSize="13.5" />
                                                <TextBlock Text="{Binding Summary}" FontSize="11.5" Foreground="{StaticResource TextFaintBrush}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </HierarchicalDataTemplate>
                                </TreeView.ItemTemplate>
                            </TreeView>
                        </DockPanel>
                    </Border>

                    <!-- редактор -->
                    <Border Grid.Column="2" Style="{StaticResource Card}" Padding="0">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel x:Name="Editor" Margin="22,20,22,22">

                                <!-- шапка: превью шарика + название + тип -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid Width="76" Height="76" VerticalAlignment="Top">
                                        <Ellipse Fill="{Binding BallBrush}" Stroke="#40FFFFFF" StrokeThickness="1" />
                                        <TextBlock Text="{Binding Icon}" FontFamily="Segoe UI Emoji" FontSize="30" Foreground="White"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Grid>
                                    <StackPanel Grid.Column="1" Margin="18,0,0,0">
                                        <TextBox x:Name="TitleBox" FontSize="17" Padding="12,8" Tag="Название шарика"
                                                 Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" />
                                        <Border Background="{StaticResource InputBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                                CornerRadius="10" Padding="3" Margin="0,10,0,0" HorizontalAlignment="Left">
                                            <StackPanel Orientation="Horizontal">
                                                <RadioButton x:Name="RbCategory" Style="{StaticResource Segment}" GroupName="Kind" Checked="Kind_Checked"
                                                             Content="📂  Категория" ToolTip="При наведении из неё вырастают ветки к вложенным шарикам" />
                                                <RadioButton x:Name="RbButton" Style="{StaticResource Segment}" GroupName="Kind" Checked="Kind_Checked"
                                                             Content="⚡  Кнопка" ToolTip="Выполняет действия по порядку" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Grid>

                                <!-- иконка -->
                                <TextBlock Style="{StaticResource Label}" Text="ИКОНКА" />
                                <DockPanel>
                                    <TextBox DockPanel.Dock="Left" Width="64" FontFamily="Segoe UI Emoji" FontSize="18"
                                             HorizontalContentAlignment="Center" Padding="6,5" ToolTip="Можно вставить любой эмодзи (Win + .)"
                                             Text="{Binding Icon, UpdateSourceTrigger=PropertyChanged}" />
                                    <WrapPanel x:Name="IconPanel" Margin="10,0,0,0" />
                                </DockPanel>

                                <!-- цвет -->
                                <TextBlock Style="{StaticResource Label}" Text="ЦВЕТ" />
                                <DockPanel>
                                    <TextBox DockPanel.Dock="Left" Width="100" Tag="#7F77DD"
                                             Text="{Binding Color, UpdateSourceTrigger=PropertyChanged}" />
                                    <WrapPanel x:Name="SwatchPanel" Margin="12,0,0,0" VerticalAlignment="Center" />
                                </DockPanel>

                                <!-- корень -->
                                <Border x:Name="RootInfo" Background="{StaticResource AccentSoftBrush}" CornerRadius="10" Padding="14,12" Margin="0,22,0,0">
                                    <TextBlock TextWrapping="Wrap" Foreground="#CFCBFF"
                                               Text="Это центральный шар — от него идут первые ветки. В самом меню он показывает название того, на что ты навёл. Добавляй сюда категории и кнопки кнопками над деревом." />
                                </Border>

                                <!-- категория -->
                                <StackPanel x:Name="CategoryPanel" Margin="0,22,0,0">
                                    <Border Background="{StaticResource Surface2Brush}" CornerRadius="10" Padding="14,12">
                                        <StackPanel>
                                            <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextDimBrush}"
                                                       Text="Это категория. Когда в меню наводишь на неё мышку, из неё вырастают ветки ко всему, что лежит внутри. Вложенность — любая." />
                                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                                <Button Content="＋ Кнопка внутрь" Click="AddButton_Click" Margin="0,0,8,0" />
                                                <Button Content="＋ Категория внутрь" Click="AddCategory_Click" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <!-- кнопка: действия -->
                                <StackPanel x:Name="StepsPanel">
                                    <TextBlock Style="{StaticResource Label}" Text="ЧТО ДЕЛАЕТ КНОПКА" />
                                    <TextBlock Style="{StaticResource Sub}" FontSize="12" Margin="0,-3,0,10"
                                               Text="Действия выполняются сверху вниз. Несколько действий — это сценарий: например, открыть папку, подождать и открыть сайт." />

                                    <ItemsControl x:Name="StepsList" ItemsSource="{Binding Steps}" AlternationCount="1000">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type m:ActionStep}">
                                                <Border Background="{StaticResource Surface2Brush}" BorderBrush="{StaticResource BorderBrush}"
                                                        BorderThickness="1" CornerRadius="12" Padding="14,12" Margin="0,0,0,10">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>

                                                        <Border Width="26" Height="26" CornerRadius="13" Background="{StaticResource AccentSoftBrush}"
                                                                VerticalAlignment="Top" Margin="0,5,12,0">
                                                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold"
                                                                       Foreground="#CFCBFF" FontSize="12"
                                                                       Text="{Binding (ItemsControl.AlternationIndex), RelativeSource={RelativeSource AncestorType=ContentPresenter}, Converter={StaticResource PlusOne}}" />
                                                        </Border>

                                                        <StackPanel Grid.Column="1">
                                                            <ComboBox ItemsSource="{x:Static m:ActionStep.AllTypes}"
                                                                      SelectedItem="{Binding Type, Mode=TwoWay}" HorizontalAlignment="Left" MinWidth="300">
                                                                <ComboBox.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <TextBlock Text="{Binding Converter={StaticResource TypeName}}" />
                                                                    </DataTemplate>
                                                                </ComboBox.ItemTemplate>
                                                            </ComboBox>

                                                            <DockPanel Margin="0,8,0,0" Visibility="{Binding NeedsArgument, Converter={StaticResource B2V}}">
                                                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                                                            Visibility="{Binding CanBrowse, Converter={StaticResource B2V}}">
                                                                    <Button Content="Файл…" Click="BrowseFile_Click" Margin="8,0,0,0" Padding="11,7" />
                                                                    <Button Content="Папка…" Click="BrowseFolder_Click" Margin="6,0,0,0" Padding="11,7" />
                                                                </StackPanel>
                                                                <TextBox Text="{Binding Argument, UpdateSourceTrigger=PropertyChanged}" Tag="{Binding Placeholder}" />
                                                            </DockPanel>

                                                            <TextBox Margin="0,8,0,0" Tag="Аргументы запуска (необязательно), например --fullscreen"
                                                                     Text="{Binding ExtraArgs, UpdateSourceTrigger=PropertyChanged}"
                                                                     Visibility="{Binding CanBrowse, Converter={StaticResource B2V}}" />

                                                            <TextBlock Margin="2,7,0,0" Text="{Binding Hint}" FontSize="11.5" TextWrapping="Wrap"
                                                                       Foreground="{StaticResource TextFaintBrush}" />
                                                        </StackPanel>

                                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top" Margin="8,2,0,0">
                                                            <Button Style="{StaticResource IconButton}" Content="↑" ToolTip="Выше" Click="StepUp_Click" />
                                                            <Button Style="{StaticResource IconButton}" Content="↓" ToolTip="Ниже" Click="StepDown_Click" />
                                                            <Button Style="{StaticResource DangerIconButton}" Content="✕" ToolTip="Удалить действие" Click="StepRemove_Click" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <TextBlock x:Name="NoStepsText" Style="{StaticResource Sub}" Margin="2,0,0,10"
                                               Text="Пока кнопка ничего не делает — добавь действие." />

                                    <StackPanel Orientation="Horizontal">
                                        <Button x:Name="AddStepButton" Click="AddStep_Click" Margin="0,0,8,0">
                                            <TextBlock Text="＋ Добавить действие" />
                                        </Button>
                                        <Button Click="TestButton_Click" ToolTip="Выполнить действия этой кнопки прямо сейчас">
                                            <TextBlock Text="▶ Выполнить сейчас" />
                                        </Button>
                                    </StackPanel>

                                    <!-- выбор типа нового действия -->
                                    <Popup x:Name="AddStepPopup" PlacementTarget="{Binding ElementName=AddStepButton}" Placement="Top"
                                           StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade" VerticalOffset="-6">
                                        <Border Background="{StaticResource Surface2Brush}" BorderBrush="{StaticResource BorderHoverBrush}"
                                                BorderThickness="1" CornerRadius="12" Padding="8">
                                            <StackPanel>
                                                <TextBlock Text="Что добавить?" Margin="6,2,6,8" Foreground="{StaticResource TextDimBrush}" FontSize="12" />
                                                <UniformGrid x:Name="StepTypeGrid" Columns="2" Width="560" />
                                            </StackPanel>
                                        </Border>
                                    </Popup>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Grid>

            <!-- ============ страница: хоткей и запуск ============ -->
            <ScrollViewer x:Name="PageControls" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="26,22,26,12" MaxWidth="760" HorizontalAlignment="Left">
                    <TextBlock Style="{StaticResource H1}" Text="Хоткей и запуск" />
                    <TextBlock Style="{StaticResource Sub}" Margin="0,4,0,18" Text="Как открывать меню и когда запускаться." />

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource H2}" Text="Хоткей меню" />
                            <TextBlock Style="{StaticResource Sub}" Margin="0,4,0,14"
                                       Text="Кликни по полю и нажми нужную комбинацию. Лучше с модификатором (Alt, Ctrl, Win), чтобы клавиша не мешала печатать." />
                            <StackPanel Orientation="Horizontal">
                                <TextBox x:Name="HotkeyBox" Width="260" FontSize="16" Padding="14,10" IsReadOnly="True" Cursor="Hand"
                                         HorizontalContentAlignment="Center"
                                         PreviewKeyDown="HotkeyBox_PreviewKeyDown"
                                         GotKeyboardFocus="HotkeyBox_GotKeyboardFocus"
                                         LostKeyboardFocus="HotkeyBox_LostKeyboardFocus" />
                                <TextBlock x:Name="HotkeyHint" Style="{StaticResource Sub}" VerticalAlignment="Center" Margin="14,0,0,0"
                                           Text="Esc — отменить ввод" />
                            </StackPanel>

                            <Grid Margin="0,20,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Background="{StaticResource Surface2Brush}" CornerRadius="10" Padding="14,12">
                                    <StackPanel>
                                        <TextBlock Text="Зажать и отпустить" FontWeight="SemiBold" />
                                        <TextBlock Style="{StaticResource Sub}" FontSize="12" Margin="0,4,0,0"
                                                   Text="Держишь хоткей, ведёшь мышку к кнопке и отпускаешь — она срабатывает. Отпустил в пустоте — отмена." />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="2" Background="{StaticResource Surface2Brush}" CornerRadius="10" Padding="14,12">
                                    <StackPanel>
                                        <TextBlock Text="Нажать и кликать" FontWeight="SemiBold" />
                                        <TextBlock Style="{StaticResource Sub}" FontSize="12" Margin="0,4,0,0"
                                                   Text="Коротко нажал хоткей — меню остаётся открытым. ЛКМ — выбрать, ПКМ — назад, Esc — закрыть." />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock Style="{StaticResource H2}" Text="Запуск" />
                            <CheckBox x:Name="AutostartBox" Margin="0,14,0,0" Checked="AnySetting_Changed" Unchecked="AnySetting_Changed">
                                <StackPanel>
                                    <TextBlock Text="Запускать вместе с Windows" />
                                    <TextBlock Style="{StaticResource Sub}" FontSize="12" Text="Приложение тихо сидит в трее и ждёт хоткей" />
                                </StackPanel>
                            </CheckBox>
                            <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                                <Button Content="📂  Папка с настройками" Click="OpenConfigFolder_Click" Margin="0,0,8,0" />
                                <Button Content="↺  Вернуть пример меню" Click="ResetMenu_Click" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ============ страница: внешний вид ============ -->
            <ScrollViewer x:Name="PageLook" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="26,22,26,12" MaxWidth="760" HorizontalAlignment="Left">
                    <TextBlock Style="{StaticResource H1}" Text="Внешний вид" />
                    <TextBlock Style="{StaticResource Sub}" Margin="0,4,0,18" Text="Как выглядит меню поверх экрана. Жми «Проверить меню» слева, чтобы сразу увидеть результат." />

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <CheckBox x:Name="BlurBox" Checked="AnySetting_Changed" Unchecked="AnySetting_Changed">
                                <StackPanel>
                                    <TextBlock Text="Размывать фон под меню" />
                                    <TextBlock Style="{StaticResource Sub}" FontSize="12" Text="Экран за шариками мягко размывается, чтобы они читались лучше" />
                                </StackPanel>
                            </CheckBox>

                            <DockPanel Margin="0,24,0,0">
                                <TextBlock x:Name="DimValue" DockPanel.Dock="Right" Foreground="{StaticResource TextDimBrush}" Width="44" TextAlignment="Right" />
                                <TextBlock Text="Затемнение фона" />
                            </DockPanel>
                            <Slider x:Name="DimSlider" Minimum="0" Maximum="0.85" Margin="0,8,0,0" ValueChanged="DimSlider_ValueChanged" />

                            <DockPanel Margin="0,22,0,0">
                                <TextBlock x:Name="ScaleValue" DockPanel.Dock="Right" Foreground="{StaticResource TextDimBrush}" Width="44" TextAlignment="Right" />
                                <TextBlock Text="Размер шариков" />
                            </DockPanel>
                            <Slider x:Name="ScaleSlider" Minimum="0.7" Maximum="1.5" Margin="0,8,0,0" ValueChanged="ScaleSlider_ValueChanged" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ============ страница: обновления ============ -->
            <ScrollViewer x:Name="PageUpdates" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="26,22,26,12" MaxWidth="760" HorizontalAlignment="Left">
                    <TextBlock Style="{StaticResource H1}" Text="Обновления" />
                    <TextBlock Style="{StaticResource Sub}" Margin="0,4,0,18" Text="Новые версии приходят из GitHub Releases и ставятся сами." />

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Версия " FontSize="15" Foreground="{StaticResource TextDimBrush}" />
                                <TextBlock x:Name="UpdVersion" FontSize="15" FontWeight="SemiBold" />
                            </StackPanel>
                            <TextBlock x:Name="UpdStatus" Style="{StaticResource Sub}" Margin="0,6,0,0" />

                            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                <Button x:Name="UpdCheckButton" Style="{StaticResource AccentButton}" Content="Проверить сейчас"
                                        Click="CheckUpdates_Click" Margin="0,0,8,0" />
                                <Button Content="Все версии на GitHub ↗" Click="OpenReleases_Click" />
                            </StackPanel>

                            <CheckBox x:Name="AutoUpdateBox" Margin="0,22,0,0" Checked="AnySetting_Changed" Unchecked="AnySetting_Changed">
                                <StackPanel>
                                    <TextBlock Text="Обновляться автоматически" />
                                    <TextBlock Style="{StaticResource Sub}" FontSize="12"
                                               Text="Раз в несколько часов проверяет GitHub и ставит новую версию. Если она не запустится — сам откатится назад." />
                                </StackPanel>
                            </CheckBox>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ===================== низ ===================== -->
            <Border Grid.Row="1" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="26,12">
                <DockPanel LastChildFill="False">
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse x:Name="DirtyDot" Width="8" Height="8" Fill="{StaticResource WarnBrush}" Margin="0,0,8,0" Visibility="Collapsed" />
                        <TextBlock x:Name="DirtyText" Foreground="{StaticResource TextDimBrush}" Text="Все изменения сохранены" />
                    </StackPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource AccentButton}" Content="Сохранить" MinWidth="120"
                            Click="Save_Click" ToolTip="Ctrl + S" />
                    <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="Отменить изменения" Margin="0,0,8,0"
                            Click="Revert_Click" />
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
